# Set only on the server. Never use VITE_ for the operator credential.
TALAI_OPERATOR_PASSWORD=
TALAI_PUBLIC_ORIGIN=https://your-confirmed-domain.example
TALAI_DATA_DIR=/private/talai-storage
# Browser-visible API key. Configure allowed origins and service limits in 2GIS account.
VITE_2GIS_API_KEY=
# Serve through HTTPS reverse proxy. Do not expose Vite development server publicly.
